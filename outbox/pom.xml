    <parent>
        <groupId>com.atwms</groupId>
        <artifactId>saas-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>outbox</artifactId>
    <packaging>jar</packaging>
    <name>Outbox (transaktionssichere Event-Veroeffentlichung)</name>

    <description>
        Bewusst ein eigenes Modul und nicht Teil von "common": Weld prueft beim
        Deployment die Injektionspunkte aller gefundenen Beans. Laege die Outbox
        in common, muesste jeder Service einen EntityManager und einen
        Kafka-Kanal dafuer bereitstellen - auch die, die gar keine Events
        publizieren. Diese Abhaengigkeit zieht sich nur herein, wer sie braucht.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.atwms</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.platform</groupId>
