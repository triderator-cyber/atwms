<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="tenantPU" transaction-type="JTA">
        <!--
            Jeder Service besitzt seine eigene Datenbank (Database per Service).
            Die DataSource wird von der Anwendung selbst definiert, siehe
            DataSourceConfig mit @DataSourceDefinition.
        -->
        <jta-data-source>java:app/jdbc/TenantDS</jta-data-source>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Nur fuer die lokale Entwicklung. In Produktion uebernimmt
                 Flyway/Liquibase die Schemaverwaltung: hbm2ddl auf "none". -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="jakarta.persistence.validation.mode" value="AUTO"/>
        </properties>
    </persistence-unit>
</persistence>
